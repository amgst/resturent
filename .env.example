# Copy this file to .env and fill in your own values.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Firebase (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firestore database (server side) — a Firebase SERVICE ACCOUNT key. This one IS secret.
# Get it: Firebase console → Project settings → Service accounts → Generate new private key.
#
# Locally: save the downloaded file as firebase-service-account.json in the project folder
# (it is git-ignored) and point to it:
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
#
# On Vercel: add FIREBASE_SERVICE_ACCOUNT and paste the whole file contents as the value.
# FIREBASE_SERVICE_ACCOUNT=
#
# Without either, local development uses data/restaurant-data.json instead.
